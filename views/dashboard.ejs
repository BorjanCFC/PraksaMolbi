<!DOCTYPE html>
<html lang="mk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Систем за електронско поднесување молби</title>
  <link rel="icon" type="image/png" sizes="64x64" href="/images/feitLogoBrowser.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header', { viewer, isImpersonating }) %>

  <!-- MOLBI_STUDENT_REVISION_V1 -->
  <main class="container">
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (!isStudent) { %>
      <div class="dashboard-header">
        <div>
          <h2>Сите молби</h2>
        </div>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number"><%= stats.vkupno %></div>
          <div class="stat-label">Вкупно молби</div>
        </div>

        <div class="stat-card stat-proces">
          <div class="stat-number"><%= stats.voProces %></div>
          <div class="stat-label">Во процес</div>
        </div>

        <% if (viewer.role === 'prodekan') { %>
        <div class="stat-card stat-zabeleshka">
          <div class="stat-number"><%= stats.zabeleshki %></div>
          <div class="stat-label">Забелешка</div>
        </div>
        <% } %>

        <div class="stat-card stat-odobrena">
          <div class="stat-number"><%= stats.odobreni %></div>
          <div class="stat-label">Одобрени</div>
        </div>

        <div class="stat-card stat-odbiena">
          <div class="stat-number"><%= stats.odbieni %></div>
          <div class="stat-label">Одбиени</div>
        </div>
      </div>

      <!-- MOLBI_ACADEMIC_PERIOD_ARCHIVE_V1 -->
      <!-- MOLBI_ACADEMIC_PERIOD_ARCHIVE_REFINEMENTS_V2 -->
      <div class="current-academic-period-banner <%= activeAcademicPeriod ? 'period-open' : 'period-missing' %>">
        <div>
          <span class="current-period-label">Тековен семестар</span>
          <% if (activeAcademicPeriod) { %><strong><%= activeAcademicPeriod.semestar %> <%= activeAcademicPeriod.ucebnaGodina %></strong><% } %>
        </div>
        <a href="/dashboard/archive" class="btn btn-secondary btn-small">Архива на молби</a>
      </div>

      <% if (isGlobalAdmin) { %>
        <div class="admin-action-card" style="margin-bottom: 1.5rem; max-width: 100%;">
          <h3>Додели улога</h3>

          <p style="margin: 0.35rem 0 1rem; color: #64748b; font-size: 14px;">
            Доколку корисникот веќе има друга улога, новата ќе биде додадена како дополнителна.
            Постоечките улоги нема да бидат заменети.
          </p>

          <form action="/dashboard/assign-role" method="POST">
            <input type="hidden" name="csrfToken" value="<%= adminCsrfToken %>">
            <div class="form-row">
              <div class="form-group">
                <label for="assignEmail">Email</label>
                <input
                  id="assignEmail"
                  name="email"
                  type="email"
                  placeholder="Внеси валидна email адреса"
                  required
                >
              </div>

              <div class="form-group">
                <label for="assignStaffIme">Име</label>
                <input id="assignStaffIme" name="ime" type="text" maxlength="100"
                       placeholder="Борјан" autocomplete="given-name" required>
              </div>

              <div class="form-group">
                <label for="assignStaffPrezime">Презиме</label>
                <input id="assignStaffPrezime" name="prezime" type="text" maxlength="100"
                       placeholder="Петревски" autocomplete="family-name" required>
              </div>

              <div class="form-group">
                <label for="assignRole">Улога</label>
                <select id="assignRole" name="role" class="form-select" required>
                  <option value="admin">Админ</option>
                  <option value="studentska_sluzhba">Студентска служба</option>
                  <option value="prodekan">Продекан</option>
                  <option value="arhiva">Архива</option>
                </select>
              </div>

              <div class="form-group">
                <label for="assignAuthServer">Mail server</label>
                <select id="assignAuthServer" name="authServer" class="form-select" required>
                  <option value="makedon" selected>makedon.feit.ukim.edu.mk</option>
                  <option value="smail">smail.feit.ukim.edu.mk</option>
                </select>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-admin">Зачувај улога</button>
            </div>
          </form>
        </div>

        <section class="admin-role-registry" aria-labelledby="admin-role-list-title">
          <div class="admin-role-registry-heading">
            <h3 id="admin-role-list-title">Корисници со административни улоги</h3>
            <p class="subtitle">Преглед и управување со доделените улоги. Студентската улога не се отстранува од оваа табела.</p>
          </div>
          <% if (adminAccounts.length === 0) { %>
            <p class="admin-role-empty">Нема корисници со доделени административни улоги.</p>
          <% } else { %>
            <div class="admin-role-table-scroll">
              <table class="admin-role-table admin-user-directory">
                <thead>
                  <tr>
                    <th>Корисник</th>
                    <th>Email</th>
                    <th>Доделени улоги</th>
                    <th>Сервер</th>
                    <th>Акции</th>
                  </tr>
                </thead>
                <tbody>
                  <% adminAccounts.forEach((account) => { %>
                    <tr>
                      <td class="admin-directory-name">
                        <%= account.ime && account.prezime
                          ? convertNameToCyrillic(account.ime) + ' ' + convertNameToCyrillic(account.prezime) : '—' %>
                      </td>
                      <td class="admin-directory-email"><%= account.email %></td>
                      <td class="admin-directory-roles">
                        <% account.roles.forEach((role, index) => { %>
                          <span class="admin-directory-role"><%= role.label %><%= index < account.roles.length - 1 ? ',' : '' %></span>
                        <% }) %>
                      </td>
                      <td class="admin-directory-server"><%= account.authServer === 'makedon'
                        ? 'makedon.feit.ukim.edu.mk' : 'smail.feit.ukim.edu.mk' %></td>
                      <td class="admin-directory-action">
                        <a class="btn btn-admin btn-small" href="/dashboard/admin-users/<%= account.userId %>">Детали</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>

        <section class="academic-period-admin-card" aria-labelledby="academic-period-admin-title">
          <div class="academic-period-admin-heading">
            <div>
              <h3 id="academic-period-admin-title">Управување со семестар</h3>
              <p>Администраторот го определува семестарот и учебната година за сите нови молби.</p>
            </div>
          </div>

          <% if (activeAcademicPeriod) { %>
            <div class="academic-period-open-state">
              <div class="academic-period-open-info">
                <span class="academic-period-status-dot"></span>
                <div>
                  <span>Отворен семестар</span>
                  <strong><%= activeAcademicPeriod.semestar %> <%= activeAcademicPeriod.ucebnaGodina %></strong>
                </div>
              </div>

              <form action="/dashboard/academic-period/close" method="POST" onsubmit="return confirm('Дали сте сигурни дека сакате да го затворите тековниот семестар? Со затворање на тековниот семестар, сите негови молби ќе бидат достапни во архива на молби.');">
                <input type="hidden" name="csrfToken" value="<%= adminCsrfToken %>">
                <button type="submit" class="btn academic-period-close-btn">Затвори семестар</button>
              </form>
            </div>
          <% } else { %>
            <div class="academic-period-create-state">
              <div class="academic-period-no-open">
                <strong>Нема отворен семестар</strong>
                <span>Отворете семестар за студентите повторно да можат да поднесуваат нови молби.</span>
              </div>

              <form action="/dashboard/academic-period/open" method="POST" class="academic-period-open-form">
                <input type="hidden" name="csrfToken" value="<%= adminCsrfToken %>">

                <div class="form-group">
                  <label for="openSemester">Семестар</label>
                  <select id="openSemester" name="semestar" class="form-select" required>
                    <option value="" selected disabled>Изберете семестар</option>
                    <option value="Зимски">Зимски</option>
                    <option value="Летен">Летен</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="openAcademicYear">Учебна година</label>
                  <input id="openAcademicYear" name="ucebnaGodina" type="text" maxlength="9" pattern="^\d{4}\/\d{4}$" placeholder="2026/2027" required>
                </div>

                <div class="form-group academic-period-open-action">
                  <button type="submit" class="btn btn-primary">Отвори семестар</button>
                </div>
              </form>
            </div>
          <% } %>
        </section>
      <% } %>

      <!-- =================================================
           STAFF FILTERS
      ================================================== -->
      <div class="filter-bar">
        <div class="filter-group">
          <label for="statusFilter">Статус:</label>
          <select id="statusFilter" class="form-select filter-select">
            <option value="site" <%= currentStatus === 'site' ? 'selected' : '' %>>Сите</option>
            <option value="Во процес" <%= currentStatus === 'Во процес' ? 'selected' : '' %>>Во процес</option>
            <option value="Забелешка" <%= currentStatus === 'Забелешка' ? 'selected' : '' %>>Забелешка</option>
            <option value="Одобрена" <%= currentStatus === 'Одобрена' ? 'selected' : '' %>>Одобрена</option>
            <option value="Одбиена" <%= currentStatus === 'Одбиена' ? 'selected' : '' %>>Одбиена</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="semestarFilter">Семестар:</label>
          <select id="semestarFilter" class="form-select filter-select">
            <option value="site" <%= currentSemestar === 'site' ? 'selected' : '' %>>Сите</option>
            <option value="Зимски" <%= currentSemestar === 'Зимски' ? 'selected' : '' %>>Зимски</option>
            <option value="Летен" <%= currentSemestar === 'Летен' ? 'selected' : '' %>>Летен</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="academicYearFilter">Учебна година:</label>
          <select id="academicYearFilter" class="form-select filter-select">
            <option value="site" <%= currentAcademicYear === 'site' ? 'selected' : '' %>>Сите</option>

            <% academicYearOptions.forEach((year) => { %>
              <option
                value="<%= year %>"
                <%= currentAcademicYear === year ? 'selected' : '' %>
              >
                <%= year %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="filter-group">
          <label for="ciklusFilter">Циклус на студии:</label>
          <select id="ciklusFilter" class="form-select filter-select">
            <option value="site" <%= currentCiklus === 'site' ? 'selected' : '' %>>Сите</option>
            <option value="Прв" <%= currentCiklus === 'Прв' ? 'selected' : '' %>>Прв циклус</option>
            <option value="Втор" <%= currentCiklus === 'Втор' ? 'selected' : '' %>>Втор циклус</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="studentIndexFilter">Бр. индекс:</label>
          <input
            id="studentIndexFilter"
            class="form-select filter-select"
            type="text"
            value="<%= currentStudentIndex %>"
            placeholder="Пр. 106/2022"
            autocomplete="off"
          >
        </div>

        <div class="filter-group">
          <label for="fromDate">Од датум:</label>
          <input
            id="fromDate"
            class="form-select filter-select"
            type="date"
            value="<%= currentFromDate %>"
          >
        </div>

        <div class="filter-group">
          <label for="toDate">До датум:</label>
          <input
            id="toDate"
            class="form-select filter-select"
            type="date"
            value="<%= currentToDate %>"
          >
        </div>

        <button
          type="button"
          class="btn btn-primary btn-small"
          onclick="applyFilters()"
        >
          Примени
        </button>

        <button
          type="button"
          class="btn btn-secondary btn-small"
          onclick="clearFilters()"
        >
          Исчисти
        </button>
      </div>

      <script>

        function applyFilters() {
          const status = document.getElementById('statusFilter').value;
          const semestar = document.getElementById('semestarFilter').value;
          const ucebnaGodina = document.getElementById('academicYearFilter').value;
          const ciklus = document.getElementById('ciklusFilter').value;
          const studentIndex = document.getElementById('studentIndexFilter').value.trim();
          const fromDate = document.getElementById('fromDate').value;
          const toDate = document.getElementById('toDate').value;

          const params = new URLSearchParams();

          params.set('status', status);
          params.set('semestar', semestar);
          params.set('ucebnaGodina', ucebnaGodina);
          params.set('ciklus', ciklus);
          params.set('studentIndex', studentIndex);
          params.set('fromDate', fromDate);
          params.set('toDate', toDate);

          window.location.href = '/dashboard?' + params.toString();
        }

        function clearFilters() {
          window.location.href =
            '/dashboard?status=site&semestar=site&ucebnaGodina=site&ciklus=site&studentIndex=&fromDate=&toDate=';
        }
      </script>

      <!-- MOLBI_INLINE_REVISION_UI_V2 -->
      <% if (isGlobalAdmin) { %>
        <div class="dashboard-header" style="margin-top: 1.5rem;">
          <div>
            <h2 style="font-size: 1.55rem;">Сите молби</h2>
          </div>
        </div>

        <% if (molbi.length === 0) { %>
          <div class="empty-state">
            <h3><%= hasActiveFilters ? 'Нема молби што одговараат на применетите филтри' : 'Во моментот нема молби' %></h3>
            <p><%= hasActiveFilters ? 'Променете ги или исчистете ги филтрите.' : 'Кога ќе има молби, тие ќе се појават овде.' %></p>
          </div>
        <% } else { %>
          <div class="table-wrapper">
            <table class="molbi-table">
              <thead>
                <tr>
                  <th>Студент</th>
                  <th>Бр. индекс</th>
                  <th>Архивски број</th>
                  <th>Наслов</th>
                  <th>Семестар / учебна година</th>
                  <th>Циклус на студии</th>
                  <th>Датум</th>
                  <th>Статус</th>
                  <th>Акции</th>
                </tr>
              </thead>
              <tbody>
                <% molbi.forEach((molba) => { %>
                  <tr>
                    <td>
                      <%= convertNameToCyrillic(molba.student.ime) %>
                      <%= convertNameToCyrillic(molba.student.prezime) %>
                    </td>

                    <td>
                      <%= molba.student.brIndeks ||
                          (molba.student.studentProfile
                            ? molba.student.studentProfile.brIndeks
                            : null) ||
                          '-' %>
                    </td>

                    <td><%= molba.arhivskiBroj || '-' %></td>

                    <td class="desc-cell">
                      <%= (molba.naslov || 'Без наслов').substring(0, 70) %>
                      <%= (molba.naslov || '').length > 70 ? '...' : '' %>
                    </td>

                    <td>
                      <%= molba.semestar %> /
                      <%= molba.ucebnaGodina || '-' %>
                    </td>
                    <td><%= molba.ciklus ? molba.ciklus + ' циклус' : '—' %></td>

                    <td>
                      <% const anyDate = new Date(molba.datum); %>
                      <%= String(anyDate.getDate()).padStart(2, '0') %>.<%= String(anyDate.getMonth() + 1).padStart(2, '0') %>.<%= anyDate.getFullYear() %>
                    </td>

                    <td>
                      <span class="status-badge status-<%= molba.status === 'Во процес' ? 'proces' : molba.status === 'Забелешка' ? 'zabeleshka' : molba.status === 'Одобрена' ? 'odobrena' : 'odbiena' %>">
                        <%= molba.status %>
                      </span>
                    </td>

                    <td>
                      <a href="/dashboard/molba/<%= molba.molbaId %>" class="btn btn-small">Детали</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } else { %>
      <!-- =================================================
           ACTIVE REQUESTS
      ================================================== -->
      <div class="dashboard-header" style="margin-top: 1.5rem;">
        <div>
          <h2 style="font-size: 1.55rem;">Активни молби</h2>
        </div>
      </div>

      <% if (activeMolbi.length === 0) { %>
        <div class="empty-state">
          <h3><%= hasActiveFilters ? 'Нема активни молби што одговараат на применетите филтри' : 'Во моментот нема активни молби за Вашата улога' %></h3>
          <p><%= hasActiveFilters ? 'Променете ги или исчистете ги филтрите.' : 'Новите молби што бараат акција ќе се прикажат овде.' %></p>
        </div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="molbi-table">
            <thead>
              <tr>
                <th>Студент</th>
                <th>Бр. индекс</th>
                <th>Архивски број</th>
                <th>Наслов</th>
                <th>Семестар / учебна година</th>
                <th>Циклус на студии</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Акции</th>
              </tr>
            </thead>

            <tbody>
              <% activeMolbi.forEach((molba) => { %>
                <tr>
                  <td>
                    <%= convertNameToCyrillic(molba.student.ime) %>
                    <%= convertNameToCyrillic(molba.student.prezime) %>
                  </td>

                  <td>
                    <%= molba.student.brIndeks ||
                        (molba.student.studentProfile
                          ? molba.student.studentProfile.brIndeks
                          : null) ||
                        '-' %>
                  </td>

                  <td><%= molba.arhivskiBroj || '-' %></td>

                  <td class="desc-cell">
                    <%= (molba.naslov || 'Без наслов').substring(0, 70) %>
                    <%= (molba.naslov || '').length > 70 ? '...' : '' %>
                  </td>

                  <td>
                    <%= molba.semestar %> /
                    <%= molba.ucebnaGodina || '-' %>
                  </td>
                  <td><%= molba.ciklus ? molba.ciklus + ' циклус' : '—' %></td>

                  <td>
                    <%
                      const activeDate = new Date(molba.datum);
                      const activeDay = String(activeDate.getDate()).padStart(2, '0');
                      const activeMonth = String(activeDate.getMonth() + 1).padStart(2, '0');
                      const activeYear = activeDate.getFullYear();
                    %>
                    <%= activeDay %>.<%= activeMonth %>.<%= activeYear %>
                  </td>

                  <td>
                    <span class="status-badge status-<%= molba.status === 'Во процес' ? 'proces' : molba.status === 'Забелешка' ? 'zabeleshka' : molba.status === 'Одобрена' ? 'odobrena' : 'odbiena' %>">
                      <%= molba.status %>
                    </span>
                  </td>

                  <td>
                    <a
                      href="/dashboard/molba/<%= molba.molbaId %>"
                      class="btn btn-small"
                    >
                      <%= viewer.role === 'arhiva' ? 'Архивирај' : 'Детали' %>
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <!-- =================================================
           COMPLETED REQUESTS
      ================================================== -->
      <div class="dashboard-header" style="margin-top: 2rem;">
        <div>
          <h2 style="font-size: 1.55rem;">Завршени молби</h2>
        </div>
      </div>

      <% if (completedMolbi.length === 0) { %>
        <div class="empty-state">
          <h3><%= hasActiveFilters ? 'Нема завршени молби што одговараат на применетите филтри' : 'Во моментот нема завршени молби за Вашата улога' %></h3>
          <p><%= hasActiveFilters ? 'Променете ги или исчистете ги филтрите.' : 'Завршените молби ќе се прикажуваат овде.' %></p>
        </div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="molbi-table">
            <thead>
              <tr>
                <th>Студент</th>
                <th>Бр. индекс</th>
                <th>Архивски број</th>
                <th>Наслов</th>
                <th>Семестар / учебна година</th>
                <th>Циклус на студии</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Акции</th>
              </tr>
            </thead>

            <tbody>
              <% completedMolbi.forEach((molba) => { %>
                <tr>
                  <td>
                    <%= convertNameToCyrillic(molba.student.ime) %>
                    <%= convertNameToCyrillic(molba.student.prezime) %>
                  </td>

                  <td>
                    <%= molba.student.brIndeks ||
                        (molba.student.studentProfile
                          ? molba.student.studentProfile.brIndeks
                          : null) ||
                        '-' %>
                  </td>

                  <td><%= molba.arhivskiBroj || '-' %></td>

                  <td class="desc-cell">
                    <%= (molba.naslov || 'Без наслов').substring(0, 70) %>
                    <%= (molba.naslov || '').length > 70 ? '...' : '' %>
                  </td>

                  <td>
                    <%= molba.semestar %> /
                    <%= molba.ucebnaGodina || '-' %>
                  </td>
                  <td><%= molba.ciklus ? molba.ciklus + ' циклус' : '—' %></td>

                  <td>
                    <%
                      const completedDate = new Date(molba.datum);
                      const completedDay = String(completedDate.getDate()).padStart(2, '0');
                      const completedMonth = String(completedDate.getMonth() + 1).padStart(2, '0');
                      const completedYear = completedDate.getFullYear();
                    %>
                    <%= completedDay %>.<%= completedMonth %>.<%= completedYear %>
                  </td>

                  <td>
                    <span
                      class="status-badge status-<%= molba.status === 'Во процес' ? 'proces' : molba.status === 'Забелешка' ? 'zabeleshka' : molba.status === 'Одобрена' ? 'odobrena' : 'odbiena' %>"
                    >
                      <%= molba.status %>
                    </span>
                  </td>

                  <td>
                    <a
                      href="/dashboard/molba/<%= molba.molbaId %>"
                      class="btn btn-small"
                    >
                      Детали
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <% } %>
    <% } else { %>
      <div class="dashboard-header">
        <div>
          <h2>Мои молби</h2>
        </div>
        <a href="/dashboard/nova-molba" class="btn btn-primary">+ Нова молба</a>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number"><%= siteMolbi.length %></div>
          <div class="stat-label">Вкупно молби</div>
        </div>
        <div class="stat-card stat-proces">
          <div class="stat-number"><%= siteMolbi.filter(m => m.status === 'Во процес').length %></div>
          <div class="stat-label">Во процес</div>
        </div>
        <div class="stat-card stat-zabeleshka">
          <div class="stat-number"><%= siteMolbi.filter(m => m.status === 'Забелешка').length %></div>
          <div class="stat-label">Забелешка</div>
        </div>
        <div class="stat-card stat-odobrena">
          <div class="stat-number"><%= siteMolbi.filter(m => m.status === 'Одобрена').length %></div>
          <div class="stat-label">Одобрени</div>
        </div>
        <div class="stat-card stat-odbiena">
          <div class="stat-number"><%= siteMolbi.filter(m => m.status === 'Одбиена').length %></div>
          <div class="stat-label">Одбиени</div>
        </div>
      </div>

      <div class="filter-bar">
        <div class="filter-group">
          <label for="statusFilterStudent">Статус:</label>
          <select id="statusFilterStudent" class="form-select filter-select">
            <option value="site" <%= currentStatus === 'site' ? 'selected' : '' %>>Сите</option>
            <option value="Во процес" <%= currentStatus === 'Во процес' ? 'selected' : '' %>>Во процес</option>
            <option value="Забелешка" <%= currentStatus === 'Забелешка' ? 'selected' : '' %>>Забелешка</option>
            <option value="Одобрена" <%= currentStatus === 'Одобрена' ? 'selected' : '' %>>Одобрена</option>
            <option value="Одбиена" <%= currentStatus === 'Одбиена' ? 'selected' : '' %>>Одбиена</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="semesterYearFilterStudent">Семестар / учебна година:</label>

          <%
            const studentPeriodOptions = [
              ...new Map(
                siteMolbi
                  .filter(m => m.semestar && m.ucebnaGodina)
                  .map(m => [
                    `${m.semestar}|${m.ucebnaGodina}`,
                    {
                      semestar: m.semestar,
                      ucebnaGodina: m.ucebnaGodina
                    }
                  ])
              ).values()
            ].sort((a, b) => {
              const yearCompare =
                String(b.ucebnaGodina).localeCompare(
                  String(a.ucebnaGodina)
                );

              if (yearCompare !== 0) {
                return yearCompare;
              }

              if (a.semestar === b.semestar) {
                return 0;
              }

              return a.semestar === '??????' ? -1 : 1;
            });
          %>

          <select
            id="semesterYearFilterStudent"
            class="form-select filter-select student-period-filter"
          >
            <option
              value="site"
              <%= (
                currentSemestar === 'site' &&
                currentAcademicYear === 'site'
              ) ? 'selected' : '' %>
            >Сите</option>

            <% studentPeriodOptions.forEach((period) => { %>
              <option
                value="<%= period.semestar %>|<%= period.ucebnaGodina %>"
                <%= (
                  currentSemestar === period.semestar &&
                  currentAcademicYear === period.ucebnaGodina
                ) ? 'selected' : '' %>
              >
                <%= period.semestar %> <%= period.ucebnaGodina %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group">
          <label for="fromDateStudent">Од датум:</label>
          <input id="fromDateStudent" class="form-select filter-select" type="date" value="<%= currentFromDate %>">
        </div>
        <div class="filter-group">
          <label for="toDateStudent">До датум:</label>
          <input id="toDateStudent" class="form-select filter-select" type="date" value="<%= currentToDate %>">
        </div>
        <div class="student-filter-actions">
<button type="button" class="btn btn-primary btn-small" onclick="applyStudentFilters()">Примени</button>
<button type="button" class="btn btn-secondary btn-small" onclick="clearStudentFilters()">Исчисти</button>
</div>
      </div>

      <script>




        function applyStudentFilters() {
          const status =
            document.getElementById('statusFilterStudent').value;

          const semesterYear =
            document.getElementById('semesterYearFilterStudent').value;

          const fromDate =
            document.getElementById('fromDateStudent').value;

          const toDate =
            document.getElementById('toDateStudent').value;

          let semestar = 'site';
          let ucebnaGodina = 'site';

          if (semesterYear !== 'site') {
            const separatorIndex = semesterYear.indexOf('|');

            if (separatorIndex !== -1) {
              semestar =
                semesterYear.substring(0, separatorIndex);

              ucebnaGodina =
                semesterYear.substring(separatorIndex + 1);
            }
          }

          const params = new URLSearchParams();

          params.set('status', status);
          params.set('semestar', semestar);
          params.set('ucebnaGodina', ucebnaGodina);
          params.set('fromDate', fromDate);
          params.set('toDate', toDate);

          window.location.href =
            '/dashboard?' + params.toString();
        }

        function clearStudentFilters() {
          window.location.href =
            '/dashboard?status=site&semestar=site&ucebnaGodina=site&fromDate=&toDate=';
        }
      </script>

      <!-- =====================================================
           АКТИВНИ МОЛБИ
      ====================================================== -->

      <div class="dashboard-header" style="margin-top: 2rem;">
        <div>
          <h2>Активни молби</h2>
        </div>
      </div>

      <% if (activeMolbi.length === 0) { %>

        <div class="empty-state">
          <h3><%= hasActiveFilters ? 'Нема активни молби што одговараат на применетите филтри' : 'Во моментот немате активни молби' %></h3>
          <p>
            Во моментот немате молби што се во процес на обработка.
          </p>
        </div>

      <% } else { %>

        <div class="table-wrapper">
          <table class="molbi-table">

            <thead>
              <tr>
                <th>Наслов</th>
                <th>Семестар / учебна година</th>
                <th>Циклус на студии</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Акции</th>
              </tr>
            </thead>

            <tbody>

              <% activeMolbi.forEach((molba) => { %>

                <tr>
                  <td class="desc-cell">
                    <%= (molba.naslov || 'Без наслов').substring(0, 80) %>
                    <%= (molba.naslov || '').length > 80 ? '...' : '' %>
                  </td>

                  <td>
                    <%= molba.semestar %>
                    /
                    <%= molba.ucebnaGodina || '-' %>
                  </td>
                  <td><%= molba.ciklus ? molba.ciklus + ' циклус' : '—' %></td>

                  <td>
                    <%= formatDateMk(molba.datum) %>
                  </td>

                  <td>
                    <span class="status-badge status-<%= molba.status === 'Во процес' ? 'proces' : molba.status === 'Забелешка' ? 'zabeleshka' : molba.status === 'Одобрена' ? 'odobrena' : 'odbiena' %>">
                      <%= molba.status %>
                    </span>
                  </td>

                  <td>
                    <a
                      href="/dashboard/molba/<%= molba.molbaId %>"
                      class="btn btn-small"
                    >
                      Детали
                    </a>
                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>
        </div>

      <% } %>


      <!-- =====================================================
           ЗАВРШЕНИ МОЛБИ
      ====================================================== -->

      <div class="dashboard-header" style="margin-top: 2.5rem;">
        <div>
          <h2>Завршени молби</h2>
        </div>
      </div>

      <% if (completedMolbi.length === 0) { %>

        <div class="empty-state">
          <h3><%= hasActiveFilters ? 'Нема завршени молби што одговараат на применетите филтри' : 'Сè уште немате завршени молби' %></h3>
          <p>
            Одобрените и одбиените молби ќе се прикажуваат тука.
          </p>
        </div>

      <% } else { %>

        <div class="table-wrapper">
          <table class="molbi-table">

            <thead>
              <tr>
                <th>Наслов</th>
                <th>Семестар / учебна година</th>
                <th>Циклус на студии</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Акции</th>
              </tr>
            </thead>

            <tbody>

              <% completedMolbi.forEach((molba) => { %>

                <tr>
                  <td class="desc-cell">
                    <%= (molba.naslov || 'Без наслов').substring(0, 80) %>
                    <%= (molba.naslov || '').length > 80 ? '...' : '' %>
                  </td>

                  <td>
                    <%= molba.semestar %>
                    /
                    <%= molba.ucebnaGodina || '-' %>
                  </td>
                  <td><%= molba.ciklus ? molba.ciklus + ' циклус' : '—' %></td>

                  <td>
                    <%= formatDateMk(molba.datum) %>
                  </td>

                  <td>
                    <span
                      class="status-badge status-<%=
                        molba.status === 'Забелешка'
                          ? 'zabeleshka'
                          : molba.status === 'Одобрена'
                            ? 'odobrena'
                            : 'odbiena'
                      %>"
                    >
                      <%= molba.status %>
                    </span>
                  </td>

                  <td>
                    <a
                      href="/dashboard/molba/<%= molba.molbaId %>"
                      class="btn btn-small"
                    >
                      Детали
                    </a>
                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>
        </div>

      <% } %>

    <% } %>
  </main>

  <%- include('partials/footer') %>


  <!-- COMPLETED_SHOW_MORE_V1 -->

  <script>

    document.addEventListener(
      'DOMContentLoaded',
      function () {

        document
          .querySelectorAll(
            '.dashboard-header h2'
          )
          .forEach(
            function (heading) {

              if (
                heading
                  .textContent
                  .trim() !==
                'Завршени молби'
              ) {
                return;
              }


              let node =
                heading.closest(
                  '.dashboard-header'
                );


              let tableWrapper =
                null;


              while (
                node &&
                node.nextElementSibling
              ) {

                node = node.nextElementSibling;


                if (
                  node.classList &&
                  node.classList.contains(
                    'dashboard-header'
                  )
                ) {
                  break;
                }


                if (
                  node.classList &&
                  node.classList.contains(
                    'table-wrapper'
                  )
                ) {

                  tableWrapper = node;

                  break;
                }
              }


              if (!tableWrapper) {
                return;
              }


              const rows =
                Array.from(
                  tableWrapper.querySelectorAll(
                    'tbody tr'
                  )
                );


              if (
                rows.length <= 10
              ) {
                return;
              }


              rows
                .slice(10)
                .forEach(
                  function (row) {

                    row.classList.add(
                      'completed-extra-row'
                    );
                  }
                );


              const actions =
                document.createElement(
                  'div'
                );


              actions.className =
                'completed-show-more-actions';


              const button =
                document.createElement(
                  'button'
                );


              button.type =
                'button';


              button.className =
                'btn btn-secondary';


              button.textContent =
                'Види повеќе';


              button.dataset.expanded =
                'false';


              button.addEventListener(
                'click',
                function () {

                  const expanded =
                    button.dataset.expanded ===
                    'true';


                  rows
                    .slice(10)
                    .forEach(
                      function (row) {

                        row.classList.toggle(
                          'completed-extra-row',
                          expanded
                        );
                      }
                    );


                  button.dataset.expanded =
                    expanded
                      ? 'false'
                      : 'true';


                  button.textContent =
                    expanded
                      ? 'Види повеќе'
                      : 'Прикажи помалку';
                }
              );


              actions.appendChild(
                button
              );


              tableWrapper
                .insertAdjacentElement(
                  'afterend',
                  actions
                );
            }
          );
      }
    );

  </script>

</body>
</html>
