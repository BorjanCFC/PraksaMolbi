<!DOCTYPE html>
<html lang="mk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Систем за електронско поднесување молби</title>
  <link rel="icon" type="image/png" sizes="64x64" href="/images/feitLogoBrowser.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header', { viewer, isImpersonating }) %>

  <main class="container molba-detail-page">
  <!-- detail-dashboard-back-top -->
  <div style="margin-bottom: 1rem;">
    <a
      href="/dashboard"
      class="btn btn-secondary"
    >
      ← Назад
    </a>
  </div>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="detail-card">
      <div class="detail-header">
        <h2>Молба #<%= molba.molbaId %></h2>
        <span class="status-badge status-<%= molba.status === 'Во процес' ? 'proces' : molba.status === 'Одобрена' ? 'odobrena' : 'odbiena' %>">
          <%= molba.status %>
        </span>
      </div>

      <div class="detail-info">
        <div class="detail-row">
          <strong>Студент:</strong>
          <span>
            <%= convertNameToCyrillic(molba.student.ime) %> <%= convertNameToCyrillic(molba.student.prezime) %>
            <% const studentBrIndeks = molba.student.brIndeks || (molba.student.studentProfile ? molba.student.studentProfile.brIndeks : null); %>
            <% if (studentBrIndeks) { %>
              <span style="color: #000000c1; margin-left: 1rem;">
                <%= studentBrIndeks %>
              </span>
            <% } %>
          </span>
        </div>
        <div class="detail-row">
          <strong>Email:</strong>
          <span><%= molba.student.email %></span>
        </div>
        <div class="detail-row">
          <strong>Датум на поднесување:</strong>
          <span><%= formatDateMk(molba.datum) %></span>
        </div>
        <div class="detail-row">
          <strong>Наслов:</strong>
          <span><%= molba.naslov || 'Без наслов' %></span>
        </div>
        <% const studentSmer = molba.student.smer || (molba.student.studentProfile ? molba.student.studentProfile.smer : null); %>
        <% if (studentSmer) { %>
          <div class="detail-row">
            <strong>Насока:</strong>
            <span><%= studentSmer %></span>
          </div>
        <% } %>
        <div class="detail-row">
          <strong>Семестар:</strong>
          <span><%= molba.semestar %></span>
        </div>
        <div class="detail-row">
          <strong>Учебна година:</strong>
          <span><%= molba.ucebnaGodina || 'Нема податок' %></span>
        </div>
        <div class="detail-row">
          <strong>Архивски број:</strong>
          <span><%= molba.arhivskiBroj || 'Не е внесено' %></span>
        </div>
      </div>

      <div class="detail-section">
        <h3>Опис на молбата</h3>
        <div class="detail-text detail-description-full"><%= molba.description %></div>
      </div>

      <div class="detail-section">
        <h3>Документи</h3>
        <div class="doc-actions">
          <% if (molba.urlPath) { %>
            <a href="/dashboard/molba/<%= molba.molbaId %>/document/student" class="btn btn-small">Симни приложен документ</a>
          <% } else { %>
            <p class="subtitle">Нема приложен документ за оваа молба.</p>
          <% } %>

          <% if (molba.arhivaPdfPath) { %>
            <a href="/dashboard/molba/<%= molba.molbaId %>/document/archive" class="btn btn-small">Преглед/симни генериран PDF</a>
          <% } %>
        </div>

  

        <% if (canArchiveNumber) { %>

          <div
            class="workflow-inline-section archive-number-edit-section"
          >

            <h3 class="workflow-inline-title">
              Архивски број
            </h3>

            <form
              action="/dashboard/molba/<%= molba.molbaId %>/archive-number"
              method="POST"
              class="archive-number-form"
            >

              <div class="form-group">

                <input
                  type="text"
                  id="arhivskiBroj"
                  name="arhivskiBroj"
                  value="<%= molba.arhivskiBroj || '' %>"
                  required
                >

              </div>


              <div class="form-actions">

                <button
                  type="submit"
                  class="btn btn-primary"
                >
                  <%= molba.arhivskiBroj
                    ? 'Зачувај измена'
                    : 'Зачувај архивски број'
                  %>
                </button>

              </div>

            </form>

          </div>

        <% } %>

<!-- WORKFLOW_V2_COMPACT -->

  <% if (
       showInternalFeedback &&
       (
         molba.sluzhbaFeedback ||
         molba.prodekanFeedback
       )
     ) { %>

    <div
      class="workflow-inline-section workflow-feedback-section"
    >

      <% if (molba.sluzhbaFeedback) { %>

        <div class="workflow-feedback-item">

          <div class="workflow-feedback-label">
            Забелешка од студентска служба до продекан
          </div>

          <div class="workflow-feedback-text"><%= String(molba.sluzhbaFeedback || '').trim() %></div>

        </div>

      <% } %>


      <% if (molba.prodekanFeedback) { %>

        <div class="workflow-feedback-item">

          <div class="workflow-feedback-label">
            Забелешка од продекан до студентска служба
          </div>

          <div class="workflow-feedback-text"><%= String(molba.prodekanFeedback || '').trim() %></div>

        </div>

      <% } %>

    </div>

  <% } %>


  <!-- ===================================================
       STUDENTSKA SLUZHBA
  ==================================================== -->

  <% if (canServiceReview) { %>

    <div class="workflow-inline-section">

      <h3 class="workflow-inline-title">
        Забелешка за продекан
      </h3>

      <form
        action="/dashboard/molba/<%= molba.molbaId %>/service-review"
        method="POST"
      >

        <div class="form-group">

          <textarea
            id="sluzhbaFeedback"
            name="sluzhbaFeedback"
            rows="5"
          ><%= molba.sluzhbaFeedback || '' %></textarea>

        </div>


        <div class="form-actions workflow-inline-actions">

          <button
            type="submit"
            class="btn btn-primary"
          >
            Потврди проверка и испрати до продекан
          </button>

        </div>

      </form>

    </div>

  <% } %>


  <!-- ===================================================
       PRODEKAN
  ==================================================== -->

  <% if (canProdekanDecide) { %>

    <div class="workflow-inline-section">

      <h3 class="workflow-inline-title">
        Одлука на продекан
      </h3>


      <form
        action="/dashboard/molba/<%= molba.molbaId %>/status"
        method="POST"
      >

        <div class="form-group">

          <label for="status">
            Нов статус
          </label>

          <select
            id="status"
            name="status"
            class="form-select"
            required
          >

            <option value="">
              Изберете одлука
            </option>

            <option
              value="Одобрена"
            >
              Одобрена
            </option>

            <option
              value="Одбиена"
            >
              Одбиена
            </option>

          </select>

        </div>


        <div class="form-group">

          <label for="feedback">
            Повратна информација до студентот
          </label>

          <textarea
            id="feedback"
            name="feedback"
            rows="5"
          ><%= molba.feedback || '' %></textarea>

        </div>


        <div class="form-group">

          <label for="prodekanFeedback">
            Забелешка до служба
          </label>

          <textarea
            id="prodekanFeedback"
            name="prodekanFeedback"
            rows="5"
          ><%= molba.prodekanFeedback || '' %></textarea>

        </div>


        <div class="form-actions workflow-inline-actions">

          <button
            type="submit"
            class="btn btn-primary"
          >
            Зачувај одлука
          </button>

        </div>

      </form>

    </div>

  <% } %>

  <!-- /WORKFLOW_V2_COMPACT -->


      </div>

      <% if (canArchiveNumber) { %>
        
      <% } %>


      <% if (molba.feedback) { %>
        <div class="detail-section feedback-section <%= molba.status === 'Одбиена' ? 'feedback-rejected' : 'feedback-approved' %>">
          <h3><%= molba.status === 'Одбиена' ? 'Причина за одбивање' : 'Повратна информација' %></h3>
          <p class="detail-text"><%= molba.feedback %></p>
        </div>
      <% } %>

      <% if (canManage) { %>
        <div class="admin-action-card">
          <h3>Обработка на молба</h3>
          <form action="/dashboard/molba/<%= molba.molbaId %>/status" method="POST">
            <div class="form-group">
              <label for="status">Нов статус</label>
              <select id="status" name="status" class="form-select" required>
                <option value="Во процес" <%= molba.status === 'Во процес' ? 'selected' : '' %>>Во процес</option>
                <option value="Одобрена" <%= molba.status === 'Одобрена' ? 'selected' : '' %>>Одобрена</option>
                <option value="Одбиена" <%= molba.status === 'Одбиена' ? 'selected' : '' %>>Одбиена</option>
              </select>
            </div>
            <div class="form-group">
              <label for="feedback">Повратна информација кон студентот</label>
              <textarea id="feedback" name="feedback" rows="4" placeholder="Внесете причина или забелешка..."><%= molba.feedback || '' %></textarea>
            </div>
            <div class="form-actions">
              <a href="/dashboard" class="btn btn-secondary">← Назад</a>
              <button type="submit" class="btn btn-admin">Зачувај одлука</button>
            </div>
          </form>
        </div>
      <% } %>

      <% if (canGenerateMolbaPdf) { %>
        <div class="admin-action-card">
          <h3>Генерирање на PDF</h3>
          <p class="subtitle">Генерирај PDF и пратај email на студентот.</p>
          <form action="/dashboard/molba/<%= molba.molbaId %>/generate-molba-pdf" method="POST">
            <div class="form-actions">
              <button type="submit" class="btn btn-admin">Генерирај PDF</button>
            </div>
          </form>
        </div>
      <% } %>

      <% if (!canManage && !canGenerateMolbaPdf) { %>
        <div class="detail-actions">
          <a href="/dashboard" class="btn btn-secondary">← Назад</a>
        </div>
      <% } %>
    </div>
  
  


  </main>

  <%- include('partials/footer') %>
</body>
</html>
